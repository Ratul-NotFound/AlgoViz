# AlgoFlowX Environment Configuration
# Copy this file to .env and insert your Google Cloud OAuth Client ID

# Google OAuth 2.0 Client ID for Google Identity Services (GIS) & Google One Tap
# Get yours from: https://console.cloud.google.com/apis/credentials
# Ensure you add 'http://localhost:5173' and your production domain to 'Authorized JavaScript origins'
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Supabase Database Configuration (PostgreSQL Database for User Profiles & Live Counter)
# Get yours from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
